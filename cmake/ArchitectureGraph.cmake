# Configure-time graph checks. Nodes are source-relative paths or CMake targets.
# Hash keys keep punctuation in paths/target names from colliding.
function(architecture_file_key name output)
    # Windows includes may spell the same file with different case. Target names
    # remain case-sensitive; only filesystem lookup keys are normalized here.
    if(WIN32)
        string(TOLOWER "${name}" name)
    endif()
    string(SHA256 key "${name}")
    set(${output} "${key}" PARENT_SCOPE)
endfunction()

function(architecture_graph_key graph node output)
    string(SHA256 key "${graph}:${node}")
    set(${output} "architecture_${key}" PARENT_SCOPE)
endfunction()

function(architecture_graph_reset graph nodes)
    foreach(node IN LISTS nodes)
        architecture_graph_key("${graph}" "${node}" key)
        set_property(GLOBAL PROPERTY "${key}_edges" "")
        set_property(GLOBAL PROPERTY "${key}_state" "")
        set_property(GLOBAL PROPERTY "${key}_direction_checked" "")
    endforeach()
endfunction()

function(architecture_graph_add_edge graph source destination)
    architecture_graph_key("${graph}" "${source}" key)
    get_property(edges GLOBAL PROPERTY "${key}_edges")
    list(APPEND edges "${destination}")
    list(REMOVE_DUPLICATES edges)
    set_property(GLOBAL PROPERTY "${key}_edges" "${edges}")
endfunction()

function(architecture_visit graph node path description)
    architecture_graph_key("${graph}" "${node}" key)
    get_property(state GLOBAL PROPERTY "${key}_state")
    if(state STREQUAL "active")
        list(FIND path "${node}" start)
        list(SUBLIST path ${start} -1 cycle)
        list(APPEND cycle "${node}")
        list(JOIN cycle " -> " chain)
        message(FATAL_ERROR "${description}: ${chain}")
    elseif(state STREQUAL "done")
        return()
    endif()
    set_property(GLOBAL PROPERTY "${key}_state" active)
    list(APPEND path "${node}")
    get_property(edges GLOBAL PROPERTY "${key}_edges")
    foreach(dependency IN LISTS edges)
        architecture_visit("${graph}" "${dependency}" "${path}" "${description}")
    endforeach()
    set_property(GLOBAL PROPERTY "${key}_state" done)
endfunction()

function(architecture_check_cycles graph nodes description)
    foreach(node IN LISTS nodes)
        architecture_visit("${graph}" "${node}" "" "${description}")
    endforeach()
endfunction()

# Called after cycle checking. Memoize separately for each forbidden set so a
# successful check for one direction cannot hide a different boundary violation.
function(architecture_check_direction graph node path forbidden description)
    list(APPEND path "${node}")
    if(node IN_LIST forbidden)
        list(JOIN path " -> " chain)
        message(FATAL_ERROR "${description}: ${chain}")
    endif()
    architecture_graph_key("${graph}" "${node}" key)
    string(SHA256 rule "${forbidden}")
    get_property(checked GLOBAL PROPERTY "${key}_direction_checked")
    if(rule IN_LIST checked)
        return()
    endif()
    get_property(edges GLOBAL PROPERTY "${key}_edges")
    foreach(dependency IN LISTS edges)
        architecture_check_direction("${graph}" "${dependency}" "${path}" "${forbidden}" "${description}")
    endforeach()
    set_property(GLOBAL APPEND PROPERTY "${key}_direction_checked" "${rule}")
endfunction()

function(architecture_collect_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        architecture_collect_targets("${child}" child_targets)
        list(APPEND targets ${child_targets})
    endforeach()
    set(${output} "${targets}" PARENT_SCOPE)
endfunction()

# Split only outside nested generator expressions. Conditions are not target
# names (e.g. Debug in CONFIG:Debug); payload spelling is preserved by callers.
function(architecture_split_expression text separator output)
    set(parts "")
    set(part "")
    set(depth 0)
    string(LENGTH "${text}" length)
    if(length GREATER 0)
        math(EXPR last "${length} - 1")
        foreach(index RANGE ${last})
            string(SUBSTRING "${text}" ${index} 1 character)
            if(character STREQUAL "<")
                math(EXPR depth "${depth} + 1")
            elseif(character STREQUAL ">")
                math(EXPR depth "${depth} - 1")
            endif()
            if(depth EQUAL 0 AND character STREQUAL "${separator}")
                string(REPLACE ";" "\\;" escaped "${part}")
                list(APPEND parts "${escaped}")
                set(part "")
            else()
                string(APPEND part "${character}")
            endif()
        endforeach()
    endif()
    string(REPLACE ";" "\\;" escaped "${part}")
    list(APPEND parts "${escaped}")
    set(${output} "${parts}" PARENT_SCOPE)
endfunction()

# Inspect possible build-tree values, including both IF/config branches.
# Unsupported expressions fail explicitly rather than hiding a dependency.
function(architecture_build_values entry output)
    set(values "")
    architecture_split_expression("${entry}" ";" entries)
    list(LENGTH entries entry_count)
    if(entry_count GREATER 1)
        foreach(item IN LISTS entries)
            architecture_build_values("${item}" item_values)
            list(APPEND values ${item_values})
        endforeach()
    elseif(entry MATCHES "^::@")
        # CMake cross-directory target_link_libraries lookup-scope markers.
    elseif(entry MATCHES "^\\$<.*>$")
        string(LENGTH "${entry}" length)
        math(EXPR length "${length} - 3")
        string(SUBSTRING "${entry}" 2 ${length} expression)
        architecture_split_expression("${expression}" ":" parts)
        list(GET parts 0 operation)
        string(LENGTH "${operation}" payload_start)
        math(EXPR payload_start "${payload_start} + 1")
        if(payload_start GREATER length)
            set(payload "")
        else()
            # Preserve semicolons and namespace colons in the original payload.
            string(SUBSTRING "${expression}" ${payload_start} -1 payload)
        endif()
        if(operation MATCHES "^(LINK_ONLY|BUILD_INTERFACE|BUILD_LOCAL_INTERFACE|TARGET_NAME_IF_EXISTS|TARGET_NAME|1)$" OR
           operation MATCHES "^\\$<.*>$")
            architecture_build_values("${payload}" values)
        elseif(operation STREQUAL "IF")
            architecture_split_expression("${payload}" "," branches)
            list(LENGTH branches branch_count)
            if(NOT branch_count EQUAL 3)
                message(FATAL_ERROR "Unsupported architecture dependency expression: ${entry}")
            endif()
            foreach(index 1 2)
                list(GET branches ${index} branch)
                architecture_build_values("${branch}" branch_values)
                list(APPEND values ${branch_values})
            endforeach()
        elseif(NOT operation MATCHES "^(INSTALL_INTERFACE|0)$")
            message(FATAL_ERROR "Unsupported architecture dependency expression: ${entry}")
        endif()
    elseif(entry MATCHES "\\$<")
        message(FATAL_ERROR "Unsupported architecture dependency expression: ${entry}")
    else()
        list(APPEND values "${entry}")
    endif()
    set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(architecture_link_targets entry output)
    set(targets "")
    architecture_build_values("${entry}" values)
    foreach(value IN LISTS values)
        if(NOT TARGET "${value}")
            continue()
        endif()
        get_target_property(alias "${value}" ALIASED_TARGET)
        if(alias)
            set(value "${alias}")
        endif()
        # External libraries are leaves; only project targets form this graph.
        get_target_property(imported "${value}" IMPORTED)
        if(NOT imported)
            list(APPEND targets "${value}")
        endif()
    endforeach()
    set(${output} "${targets}" PARENT_SCOPE)
endfunction()

function(architecture_check_target_cycles)
    architecture_collect_targets("${CMAKE_SOURCE_DIR}" targets)
    architecture_graph_reset(targets "${targets}")
    set(service_targets "")
    set(viewmodel_targets "")
    foreach(target IN LISTS targets)
        # Classify libraries by their actual source ownership, not target names.
        # Mixed Service/ViewModel targets are composition units; individual source
        # includes are still checked. Executables compose layers and are not roots.
        get_target_property(directory "${target}" SOURCE_DIR)
        get_target_property(type "${target}" TYPE)
        set(has_service FALSE)
        set(has_viewmodel FALSE)
        foreach(property SOURCES INTERFACE_SOURCES)
            get_target_property(source_entries "${target}" ${property})
            architecture_build_values("${source_entries}" sources)
            foreach(source IN LISTS sources)
                get_filename_component(absolute "${source}" ABSOLUTE BASE_DIR "${directory}")
                file(RELATIVE_PATH relative "${ARCHITECTURE_SOURCE_ROOT}" "${absolute}")
                if(WIN32)
                    string(TOLOWER "${relative}" relative)
                endif()
                if(relative MATCHES "^service/")
                    set(has_service TRUE)
                elseif(relative MATCHES "^viewmodels/")
                    set(has_viewmodel TRUE)
                endif()
            endforeach()
        endforeach()
        if(has_viewmodel)
            list(APPEND viewmodel_targets "${target}")
        elseif(has_service AND NOT type STREQUAL "EXECUTABLE")
            list(APPEND service_targets "${target}")
        endif()
        foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
            get_target_property(entries "${target}" ${property})
            architecture_link_targets("${entries}" dependencies)
            foreach(dependency IN LISTS dependencies)
                architecture_graph_add_edge(targets "${target}" "${dependency}")
            endforeach()
        endforeach()
    endforeach()
    architecture_check_cycles(targets "${targets}" "CMake target dependency cycle")
    foreach(target IN LISTS service_targets)
        architecture_check_direction(targets "${target}" "" "${viewmodel_targets}"
            "Service target must not depend on ViewModel target")
    endforeach()
endfunction()
