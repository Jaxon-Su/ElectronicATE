<?xml version="1.0" encoding="UTF-8"?>
<root>
  <instruments>

    <!-- 多個 Load 儀器，共用 Load_Template -->
    <instrument name="Load1" type="Load" ref="Load_Template"/>
    <instrument name="Load2" type="Load" ref="Load_Template"/>
    <instrument name="Load3" type="Load" ref="Load_Template"/>
    <instrument name="Load4" type="Load" ref="Load_Template"/>
    <instrument name="Load5" type="Load" ref="Load_Template"/>


    <!-- 多個Relay，共用 Relay_Template -->
    <instrument name="Relay1" type="Relay" ref="Relay_Template"/>
    <instrument name="Relay2" type="Relay" ref="Relay_Template"/>

    <!-- 多個示波器，共用 Scope_Template -->
    <instrument name="Oscilloscope" type="Oscilloscope" ref="Scope_Template"/>

    <!-- 多個電源，共用 Source_Template -->
    <instrument name="ACSource" type="InputSource" ref="ACSource_Template"/>

    <instrument name="DC Source1" type="InputDCSource" ref="DCSource_Template"/>
    <instrument name="DC Source2" type="InputDCSource" ref="DCSource_Template"/>
    <instrument name="DC Source3" type="InputDCSource" ref="DCSource_Template"/>


