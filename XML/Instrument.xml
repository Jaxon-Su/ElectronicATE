    <!-- 示波器模板 -->
    <instrument name="Scope_Template" type="Template">
      <model>
        <modelName>MSO44B</modelName>
        <modelName>MSO46B</modelName>
        <modelName>MSO54B</modelName>
        <modelName>MSO56B</modelName>
        <modelName>MSO58B</modelName>
        <modelName>MSO58LP</modelName>
        <modelName>MSO64B</modelName>
        <modelName>MSO68B</modelName>
        <modelName>LPD64</modelName>
      </model>
    </instrument>

    <!-- AC 電源型號：每個 model 是獨立選項；modelName 保留設備銘牌上的型號。 -->
    <instrument name="ACSource_Template" type="Template">
      <model><modelName>DE-A3000AB</modelName></model>
      <model><modelName>61505</modelName></model>
      <model><modelName>61507</modelName></model>
      <model><modelName>61508</modelName></model>
      <model><modelName>61509</modelName></model>
      <model><modelName>6415</modelName></model>
      <model><modelName>6420</modelName></model>
      <model><modelName>6430</modelName></model>
      <model><modelName>6512</modelName></model>
      <model><modelName>6520</modelName></model>
      <model><modelName>6530</modelName></model>
      <!-- 6560：本程式使用並聯單相；6590：單相或三相，三相 Vin 為線間有效值。 -->
      <model><modelName>6560</modelName></model>
      <model><modelName>6590</modelName></model>
    </instrument>

    <!-- 電源模板 -->
    <instrument name="DCSource_Template" type="Template">
        <model><modelName>62050H-40</modelName></model>
        <model><modelName>62050H-450</modelName></model>
        <model><modelName>62050H-600</modelName></model>
        <model><modelName>62075H-30</modelName></model>
        <model><modelName>62100H-40</modelName></model>
        <model><modelName>62100H-450</modelName></model>
        <model><modelName>62100H-600</modelName></model>
        <model><modelName>62100H-1000</modelName></model>
        <model><modelName>62100H-30</modelName></model>
        <model><modelName>62150H-40</modelName></model>
        <model><modelName>62150H-450</modelName></model>
        <model><modelName>62150H-600</modelName></model>
        <model><modelName>62150H-1000</modelName></model>
    </instrument>

    <!-- Relay模板 -->
    <instrument name="Relay_Template" type="Template">
    <model>
      <modelName>Modbus_RTU_4CH</modelName>
      <channels>1,2,3,4</channels>
      <subModel name="30A/28Vdc/250Vac">
      </subModel>
    </model>
    </instrument>

