cmake_minimum_required(VERSION 3.16)
if(NOT CASE)
    message(FATAL_ERROR "CASE is required")
endif()
set(root "${CMAKE_CURRENT_BINARY_DIR}/architecture-dependency-fixtures/${CASE}")
set(source_root "${root}/src")
set(guard "${CMAKE_CURRENT_LIST_DIR}/../../cmake/CheckArchitecture.cmake")
set(expected "")
set(configure FALSE)
set(extra "")

function(source name text)
    get_filename_component(directory "${source_root}/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(WRITE "${source_root}/${name}" "${text}\n")
endfunction()

function(assert_result result output expected)
    string(REGEX REPLACE "[ \t\r\n]+" " " normalized "${output}")
    if(expected)
        string(FIND "${normalized}" "${expected}" position)
        if(result EQUAL 0 OR position EQUAL -1)
            message(FATAL_ERROR "${CASE}: expected rejection '${expected}', got ${result}: ${output}")
        endif()
    elseif(NOT result EQUAL 0)
        message(FATAL_ERROR "${CASE}: valid architecture rejected: ${output}")
    endif()
endfunction()

source(data/value.h "#pragma once")
if(CASE STREQUAL "source_allowed")
    source(viewmodels/vm.h "#include \"../service/job.h\"")
    source(service/job.h "#include \"../data/value.h\"")
elseif(CASE STREQUAL "source_service_basename")
    source(service/job.cpp "#include \"vm.h\"")
    source(viewmodels/vm.h "#pragma once")
    set(expected "Service must not depend on ViewModel: service/job.cpp -> viewmodels/vm.h")
elseif(CASE STREQUAL "source_service_relative")
    source(service/job.h "#include \"../viewmodels/vm.h\"")
    source(viewmodels/vm.h "#pragma once")
    set(expected "Service must not depend on ViewModel: service/job.h -> viewmodels/vm.h")
elseif(CASE STREQUAL "source_windows_relative" OR CASE STREQUAL "source_windows_basename")
    if(CASE STREQUAL "source_windows_relative")
        source(service/job.h "#include \"../VIEWMODELS/VM.H\"")
    else()
        source(service/job.h "#include \"VM.H\"")
    endif()
    source(viewmodels/vm.h "#pragma once")
    set(expected "Service must not depend on ViewModel: service/job.h -> viewmodels/vm.h")
elseif(CASE STREQUAL "source_windows_cycle")
    source(data/a.h "#include \"B.H\"")
    source(data/b.h "#include \"A.H\"")
    set(expected "Source include dependency cycle: data/a.h -> data/b.h -> data/a.h")
elseif(CASE STREQUAL "source_service_transitive")
    source(service/job.h "#include \"infrastructure/helper.h\"")
    source(infrastructure/helper.h "#include \"viewmodels/vm.h\"")
    source(viewmodels/vm.h "#pragma once")
    set(expected "Service must not depend on ViewModel: service/job.h -> infrastructure/helper.h -> viewmodels/vm.h")
elseif(CASE STREQUAL "source_self_cycle")
    source(data/a.h "#include \"a.h\"")
    set(expected "Source include dependency cycle: data/a.h -> data/a.h")
elseif(CASE STREQUAL "source_pair_cycle")
    source(data/a.h "#include \"b.h\"")
    source(data/b.h "#include \"a.h\"")
    set(expected "Source include dependency cycle: data/a.h -> data/b.h -> data/a.h")
elseif(CASE STREQUAL "source_long_cycle")
    source(data/a.h "#include \"b.h\"")
    source(data/b.h "#include \"c.h\"")
    source(data/c.h "#include \"a.h\"")
    set(expected "Source include dependency cycle: data/a.h -> data/b.h -> data/c.h -> data/a.h")
elseif(CASE STREQUAL "source_diamond")
    source(service/a.h "#include \"b.h\"\n#include \"c.h\"")
    source(service/b.h "#include \"value.h\"")
    source(service/c.h "#include \"value.h\"")
elseif(CASE STREQUAL "source_ambiguous")
    source(service/a.h "#include \"same.h\"")
    source(service/one/same.h "#pragma once")
    source(service/two/same.h "#pragma once")
    set(expected "Ambiguous project include: service/a.h -> same.h")
elseif(CASE STREQUAL "source_explicit_duplicate")
    source(service/a.h "#include \"one/same.h\"")
    source(service/one/same.h "#pragma once")
    source(service/two/same.h "#include \"../a.h\"")
elseif(CASE STREQUAL "source_key_collision")
    source(service/a.h "#include \"a-b.h\"")
    source(service/a-b.h "#pragma once")
    source(service/a_b.h "#include \"a.h\"")
elseif(CASE STREQUAL "source_repeat_check")
    source(service/a.h "#include \"value.h\"")
    file(WRITE "${root}/repeat.cmake" "set(ARCHITECTURE_SOURCE_ROOT \"${source_root}\")\ninclude(\"${guard}\")\ninclude(\"${guard}\")\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${root}/repeat.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    assert_result("${result}" "${output}${error}" "")
    return()
elseif(CASE MATCHES "^target_")
    set(configure TRUE)
    set(extra "add_library(A INTERFACE)\nadd_library(B INTERFACE)\nadd_library(C INTERFACE)\nadd_library(D INTERFACE)\n")
    if(CASE STREQUAL "target_diamond")
        string(APPEND extra "target_link_libraries(A INTERFACE B C)\ntarget_link_libraries(B INTERFACE D)\ntarget_link_libraries(C INTERFACE D)\n")
    elseif(CASE STREQUAL "target_self_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> A")
    elseif(CASE STREQUAL "target_pair_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE B)\ntarget_link_libraries(B INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> B -> A")
    elseif(CASE STREQUAL "target_long_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE B)\ntarget_link_libraries(B INTERFACE C)\ntarget_link_libraries(C INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> B -> C -> A")
    elseif(CASE STREQUAL "target_alias_cycle")
        string(APPEND extra "add_library(Module::B ALIAS B)\ntarget_link_libraries(A INTERFACE Module::B)\ntarget_link_libraries(B INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> B -> A")
    elseif(CASE STREQUAL "target_link_only_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<LINK_ONLY:B>\")\ntarget_link_libraries(B INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> B -> A")
    elseif(CASE STREQUAL "target_if_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<IF:$<CONFIG:Debug>,B,C>\")\ntarget_link_libraries(C INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> C -> A")
    elseif(CASE STREQUAL "target_config_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<$<CONFIG:Debug>:B>\")\ntarget_link_libraries(B INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> B -> A")
    elseif(CASE STREQUAL "target_list_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<IF:$<CONFIG:Debug>,B;C,D>\")\ntarget_link_libraries(C INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> C -> A")
    elseif(CASE STREQUAL "target_condition_not_edge")
        string(APPEND extra "add_library(Debug INTERFACE)\ntarget_link_libraries(Debug INTERFACE A)\ntarget_link_libraries(A INTERFACE \"$<IF:$<CONFIG:Debug>,B;C,D>\")\n")
    elseif(CASE STREQUAL "target_build_interface_cycle")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<BUILD_INTERFACE:$<TARGET_NAME_IF_EXISTS:B>>\")\ntarget_link_libraries(B INTERFACE A)\n")
        set(expected "CMake target dependency cycle: A -> B -> A")
    elseif(CASE STREQUAL "target_install_only")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<INSTALL_INTERFACE:A>\" \"$<0:A>\")\n")
    elseif(CASE STREQUAL "target_unknown_expression")
        string(APPEND extra "target_link_libraries(A INTERFACE \"$<JOIN:B,:>\")\n")
        set(expected "Unsupported architecture dependency expression")
    elseif(CASE STREQUAL "target_subdirectory_cycle")
        file(MAKE_DIRECTORY "${root}/child")
        file(WRITE "${root}/child/CMakeLists.txt" "add_library(Child INTERFACE)\ntarget_link_libraries(Child INTERFACE A)\ntarget_link_libraries(A INTERFACE Child)\n")
        string(APPEND extra "add_subdirectory(child)\n")
        set(expected "CMake target dependency cycle: A -> Child -> A")
    elseif(CASE STREQUAL "target_service_transitive" OR CASE STREQUAL "target_viewmodel_service" OR
           CASE STREQUAL "target_service_sources_expression" OR CASE STREQUAL "target_windows_sources")
        source(service/job.h "#pragma once")
        source(viewmodels/vm.h "#pragma once")
        if(CASE STREQUAL "target_service_sources_expression")
            string(APPEND extra "target_sources(A INTERFACE \"$<BUILD_INTERFACE:${source_root}/service/job.h>\")\ntarget_sources(C INTERFACE \"$<BUILD_INTERFACE:${source_root}/viewmodels/vm.h>\")\n")
        elseif(CASE STREQUAL "target_windows_sources")
            string(APPEND extra "target_sources(A INTERFACE \"${source_root}/SERVICE/JOB.H\")\ntarget_sources(C INTERFACE \"${source_root}/VIEWMODELS/VM.H\")\n")
        else()
            string(APPEND extra "target_sources(A INTERFACE \"${source_root}/service/job.h\")\ntarget_sources(C INTERFACE \"${source_root}/viewmodels/vm.h\")\n")
        endif()
        if(NOT CASE STREQUAL "target_viewmodel_service")
            string(APPEND extra "target_link_libraries(A INTERFACE B)\ntarget_link_libraries(B INTERFACE C)\n")
            set(expected "Service target must not depend on ViewModel target: A -> B -> C")
        else()
            string(APPEND extra "target_link_libraries(C INTERFACE A)\n")
        endif()
    else()
        message(FATAL_ERROR "Unknown CASE: ${CASE}")
    endif()
elseif(CASE MATCHES "^incremental_(edit|add)$")
    set(configure TRUE)
    source(service/job.h "#pragma once")
    source(viewmodels/vm.h "#pragma once")
else()
    message(FATAL_ERROR "Unknown CASE: ${CASE}")
endif()

if(configure)
    find_program(guard_ninja NAMES ninja REQUIRED)
    file(WRITE "${root}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.16)\nproject(Guard NONE)\n${extra}\nset(ARCHITECTURE_SOURCE_ROOT \"${source_root}\")\ninclude(\"${guard}\")\n")
    # A prior incremental-add run intentionally leaves a violating file. Reuse it
    # as a valid source before configuration, without deleting any fixture tree.
    if(CASE STREQUAL "incremental_add")
        source(service/added.h "#pragma once")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${root}/build" -G Ninja
        "-DCMAKE_MAKE_PROGRAM=${guard_ninja}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHITECTURE_SOURCE_ROOT=${source_root}" -P "${guard}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
endif()
assert_result("${result}" "${output}${error}" "${expected}")

if(CASE MATCHES "^incremental_")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
    if(CASE STREQUAL "incremental_edit")
        source(service/job.h "#include \"vm.h\"")
    else()
        # Use a new filename on every run to exercise CONFIGURE_DEPENDS additions.
        string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 suffix)
        source(service/added_${suffix}.h "#include \"vm.h\"")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${root}/build"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    # Restore a valid file for repeatability; the next configure must start clean.
    if(CASE STREQUAL "incremental_add")
        source(service/added_${suffix}.h "#pragma once")
    endif()
    assert_result("${result}" "${output}${error}" "Service must not depend on ViewModel")
endif()
