foreach(spec
        "hardware/instrument|data/measurements.h|data/testsequenceresultrecord.h|Measurement capability"
        "service/brownout|data/measurements.h|data/testsequenceresultrecord.h|Measurement capability"
        "service/measurementstrategy|data/measurements.h|data/testsequenceresultrecord.h|Measurement capability"
        "service/capture|service/measurement/helper.h|service/oscilloscopestrategy/ioscilloscopemeasurestrategy.h|Capture must not"
        "service/instrumentexecutor|service/brownout/ibrownoutio.h|service/brownout/brownoutrunner.h|Instrument adapter")
    string(REPLACE "|" ";" fields "${spec}")
    list(GET fields 0 consumer)
    list(GET fields 1 helper)
    list(GET fields 2 forbidden)
    list(GET fields 3 diagnostic)
    set(root "${CMAKE_CURRENT_BINARY_DIR}/architecture-fixtures/measurement-transitive/${consumer}/src")
    foreach(path "${consumer}/consumer.cpp" "${helper}" "${forbidden}")
        get_filename_component(directory "${root}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
    endforeach()
    file(WRITE "${root}/${consumer}/consumer.cpp" "#include \"${helper}\"\n")
    file(WRITE "${root}/${helper}" "#include \"${forbidden}\"\n")
    file(WRITE "${root}/${forbidden}" "#pragma once\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHITECTURE_SOURCE_ROOT=${root}"
        -P "${CMAKE_CURRENT_LIST_DIR}/../../cmake/CheckArchitecture.cmake"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "${diagnostic}")
        message(FATAL_ERROR "Measurement dependency escaped: ${spec}: ${error}")
    endif()
endforeach()
