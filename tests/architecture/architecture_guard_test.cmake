cmake_minimum_required(VERSION 3.16)
function(check_case name layer header dependency expected)
    set(root "${CMAKE_CURRENT_BINARY_DIR}/architecture-fixtures/${name}/src")
    file(MAKE_DIRECTORY "${root}/${layer}")
    file(WRITE "${root}/${layer}/consumer.cpp" "#include \"${header}\"\n")
    if(dependency)
        get_filename_component(directory "${root}/${dependency}" DIRECTORY)
        file(MAKE_DIRECTORY "${directory}")
        file(WRITE "${root}/${dependency}" "#pragma once\n")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DARCHITECTURE_SOURCE_ROOT=${root}"
        -P "${CMAKE_CURRENT_LIST_DIR}/../../cmake/CheckArchitecture.cmake"
        RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(expected AND NOT result EQUAL 0)
        message(FATAL_ERROR "Valid architecture rejected: ${name}")
    elseif(NOT expected AND result EQUAL 0)
        message(FATAL_ERROR "Architecture violation escaped: ${name}")
    endif()
endfunction()
